root = true

[*]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,jsonl,yml,yaml}]
charset = utf-8
indent_size = 2

# CMD launchers stay ASCII-only, a UTF-8 subset without BOM.
[*.bat]
charset = utf-8
end_of_line = crlf

[.{gitignore,gitattributes,editorconfig}]
charset = utf-8

# Agent Skills require frontmatter at the first byte.
[SKILL.md]
charset = utf-8
