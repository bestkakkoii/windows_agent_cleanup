set(secure_erase_dependency_cache "${CMAKE_SOURCE_DIR}/build/dependencies" CACHE PATH
    "Ignored immutable dependency cache; never part of maintained source")

function(secure_erase_verify_dependencies)
    file(READ "${CMAKE_SOURCE_DIR}/dependencies.lock.json" lock_json)
    string(JSON dependency_count LENGTH "${lock_json}" dependencies)
    if(NOT dependency_count EQUAL 1)
        message(FATAL_ERROR "secure_erase.dependency_lock_invalid")
    endif()
    string(JSON dependency_name GET "${lock_json}" dependencies 0 name)
    string(JSON dependency_directory GET "${lock_json}" dependencies 0 directory)
    string(JSON dependency_commit GET "${lock_json}" dependencies 0 commit)
    if(NOT dependency_name STREQUAL "dear_imgui" OR
       NOT dependency_directory STREQUAL "imgui/${dependency_commit}" OR
       NOT dependency_commit MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "secure_erase.dependency_lock_invalid")
    endif()
    string(LENGTH "${dependency_commit}" commit_length)
    if(NOT commit_length EQUAL 40)
        message(FATAL_ERROR "secure_erase.dependency_commit_invalid")
    endif()
    string(JSON file_count LENGTH "${lock_json}" dependencies 0 files)
    if(file_count LESS 1)
        message(FATAL_ERROR "secure_erase.dependency_files_missing")
    endif()
    math(EXPR file_last "${file_count} - 1")
    foreach(file_index RANGE 0 ${file_last})
        string(JSON relative_path GET "${lock_json}" dependencies 0 files ${file_index} path)
        string(JSON expected_sha256 GET "${lock_json}" dependencies 0 files ${file_index} sha256)
        string(JSON expected_size GET "${lock_json}" dependencies 0 files ${file_index} size)
        if(NOT relative_path MATCHES "^(backends/)?[a-zA-Z0-9_]+[.](h|cpp|txt)$")
            message(FATAL_ERROR "secure_erase.dependency_path_invalid")
        endif()
        set(locked_file "${secure_erase_dependency_cache}/${dependency_directory}/${relative_path}")
        if(NOT EXISTS "${locked_file}" OR IS_DIRECTORY "${locked_file}")
            message(FATAL_ERROR "secure_erase.dependency_missing: ${relative_path}; run scripts/restore_dependencies.ps1 -cache_root ${secure_erase_dependency_cache}")
        endif()
        file(SHA256 "${locked_file}" actual_sha256)
        file(SIZE "${locked_file}" actual_size)
        if(NOT actual_sha256 STREQUAL expected_sha256 OR NOT actual_size EQUAL expected_size)
            message(FATAL_ERROR "secure_erase.dependency_integrity_failed: ${relative_path}")
        endif()
    endforeach()
    set(secure_erase_imgui_directory "${secure_erase_dependency_cache}/${dependency_directory}" PARENT_SCOPE)
    message(STATUS "secure_erase.dependencies_verified=true; imgui_commit=${dependency_commit}; cache=${secure_erase_dependency_cache}")
endfunction()
