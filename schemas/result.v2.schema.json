{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "windows_agent_cleanup.result.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "job_id",
    "plan_fingerprint",
    "mode",
    "status",
    "counts",
    "error_code",
    "native_code",
    "report_file",
    "resumable",
    "advisory",
    "readiness",
    "statistics",
    "phases_ms",
    "space_observations",
    "next_action",
    "retry_safe"
  ],
  "properties": {
    "schema": {
      "const": "windows_agent_cleanup.result.v2"
    },
    "request_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "plan_fingerprint": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "report_file": {
      "type": "string"
    },
    "native_code": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "completed",
        "failed",
        "pending"
      ],
      "properties": {
        "targets": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resumable": {
      "type": "boolean"
    },
    "advisory": {
      "type": "boolean"
    },
    "readiness": {
      "anyOf": [
        {
          "$ref": "#/$defs/readiness"
        },
        {
          "type": "null"
        }
      ]
    },
    "statistics": {
      "anyOf": [
        {
          "$ref": "#/$defs/statistics"
        },
        {
          "type": "null"
        }
      ],
      "description": "Quick core unique frozen-entry aggregates; null when unsupported. Logical bytes are known default-stream snapshot sums; unknown counts disclose incompleteness."
    },
    "phases_ms": {
      "$ref": "#/$defs/phases_ms",
      "description": "Steady-clock wall milliseconds. Manifest consumption/preparation is streamed together; freeze is staging finalization. Reporting starts at core return or scan report generation and ends at final construction. Total starts at wmain entry and excludes final report/stdout delivery and teardown. Unmeasured phases are null."
    },
    "space_observations": {
      "anyOf": [
        {
          "$ref": "#/$defs/space_observations"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action": {
      "$ref": "#/$defs/next_action"
    },
    "retry_safe": {
      "type": "boolean",
      "description": "Positive operation-specific evidence of a pre-dispatch refusal only; never deletion authority. False includes uncertain or admitted outcomes."
    }
  },
  "$defs": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_windows_build",
        "required_native_architecture",
        "required_process_architecture",
        "observed_windows_build",
        "native_architecture",
        "process_architecture",
        "platform_supported",
        "elevated",
        "filesystem_commands_ready",
        "observation_errors"
      ],
      "properties": {
        "required_windows_build": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "required_native_architecture": {
          "enum": [
            "unknown",
            "x86",
            "x64",
            "arm64",
            "arm",
            "other"
          ]
        },
        "required_process_architecture": {
          "enum": [
            "unknown",
            "x86",
            "x64",
            "arm64",
            "arm",
            "other"
          ]
        },
        "observed_windows_build": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "native_architecture": {
          "enum": [
            "unknown",
            "x86",
            "x64",
            "arm64",
            "arm",
            "other"
          ]
        },
        "process_architecture": {
          "enum": [
            "unknown",
            "x86",
            "x64",
            "arm64",
            "arm",
            "other"
          ]
        },
        "platform_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "elevated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "filesystem_commands_ready": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_errors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "architecture",
            "elevation"
          ],
          "properties": {
            "platform": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "native_code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "native_code": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "architecture": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "native_code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "native_code": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "elevation": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "native_code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "native_code": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "none",
            "use_supported_host",
            "request_os_consent",
            "correct_input",
            "inspect_report",
            "wait_same_invocation",
            "reconcile_unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "remove_attempted",
        "completed",
        "logical_bytes_semantics",
        "logical_bytes",
        "failed",
        "pending",
        "final_failures"
