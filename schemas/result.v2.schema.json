            "files",
            "directories",
            "unclassified"
          ],
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "directories": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "unclassified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        "completed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
