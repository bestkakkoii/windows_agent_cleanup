            "unclassified"
          ],
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "directories": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "unclassified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        "remove_attempted": {
          "type": "object",
          "additionalProperties": false,
