            "reparse",
            "identity",
            "access_lock",
            "resource",
            "report_audit",
            "other"
          ],
          "properties": {
            "scope_protection": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "reparse": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "identity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "access_lock": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "resource": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "report_audit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "other": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      }
    },
    "phases_ms": {
      "type": "object",
