              "maximum": 18446744073709551615
            }
          }
        },
        "logical_bytes_semantics": {
          "const": "frozen_default_stream_snapshot"
        },
        "logical_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected",
            "remove_attempted",
            "completed",
